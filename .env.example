# Port the Express API server listens on (also used to serve the built
# client in production). Optional - defaults to 4000 if not set.
PORT=4000

# Set to "production" when running `npm run build && npm run start` so the
# server serves the built client alongside the API on a single port.
NODE_ENV=development

# Optional. When set, the Insights feed is generated by calling the
# Anthropic API with a snapshot of your financial data, instead of the
# built-in rule-based insights. Leave unset to use the (still fully
# functional) rule-based insights - no key required to run the app.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Which Claude model to use for AI insights. Defaults to a small,
# fast model since insights are a lightweight background feature.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional. Only needed if your API key is an organization-level key that
# isn't scoped to one workspace - Anthropic will reject requests with a 400
# "not scoped to a workspace" error until this is set to that workspace's ID
# (found in the Anthropic Console under the workspace's settings). A normal
# workspace-scoped API key does not need this.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
